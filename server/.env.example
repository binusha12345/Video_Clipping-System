# Server-side environment variables
# Copy this file to .env and fill in your values

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── MongoDB ────────────────────────────────────────────────────
# Option 1: Local MongoDB (docker-compose up)
MONGODB_URI=mongodb://localhost:27017/clipforge

# Option 2: MongoDB Atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/clipforge

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── File Storage ───────────────────────────────────────────────
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=500

# ── AI Providers ───────────────────────────────────────────────
# Set to 'mock' for development (no API keys needed)
AI_STT_PROVIDER=mock
AI_LLM_PROVIDER=mock
AI_TTS_PROVIDER=mock

# OpenAI (for STT=openai, LLM=openai, TTS=openai)
OPENAI_API_KEY=

# AssemblyAI (for STT=assemblyai)
ASSEMBLYAI_API_KEY=

# ElevenLabs (for TTS=elevenlabs)
ELEVENLABS_API_KEY=

# Deepgram (for STT=deepgram)
DEEPGRAM_API_KEY=

# ── YouTube / yt-dlp ───────────────────────────────────────────
# Path to yt-dlp binary (leave empty to use bundled/PATH version)
YTDLP_PATH=

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173
